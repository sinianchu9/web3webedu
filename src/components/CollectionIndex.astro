---
import { entryPath, formatDate } from "@/lib/content";

interface Props {
  title: string;
  description: string;
  entries: any[];
  eyebrow?: string;
}

const { title, description, entries, eyebrow = "索引" } = Astro.props;
const featured = entries.slice(0, 3);
const rest = entries.slice(3);
---

<header class="index-hero">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p>{description}</p>
</header>

{featured.length > 0 && (
  <section class="section">
    <div class="section-header">
      <h2>优先阅读</h2>
      <p>从核心概览入手，再深入感兴趣的主题方向，逐步构建完整知识体系。</p>
    </div>
    <div class="entry-grid">
      {featured.map((entry) => (
        <a class="entry-link" href={entryPath(entry)}>
          <span>
            <strong>{entry.data.title}</strong>
            <p>{entry.data.description}</p>
          </span>
          <span class="meta-line">更新：{formatDate(entry.data.updatedAt)}</span>
        </a>
      ))}
    </div>
  </section>
)}


{rest.length > 0 && (
  <section class="section">
    <div class="section-header">
      <h2>全部内容</h2>
      <p>按主题分类浏览全部条目，或通过关键词检索快速定位所需内容。</p>
    </div>
    <div class="entry-grid">
      {rest.map((entry) => (
        <a class="entry-link" href={entryPath(entry)}>
          <span>
            <strong>{entry.data.title}</strong>
            <p>{entry.data.description}</p>
          </span>
          <span class="meta-line">{entry.data.type} / {entry.data.cluster ?? entry.data.section}</span>
        </a>
      ))}
    </div>
  </section>
)}
